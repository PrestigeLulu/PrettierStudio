{
  "name": "prettier-studio",
  "displayName": "Prettier Studio",
  "publisher": "PrestigeLulu",
  "description": "Easily preview and modify Prettier settings.",
  "categories": [
    "Formatters",
    "Testing",
    "Other"
  ],
  "icon": "./media/image.png",
  "repository": "https://github.com/PrestigeLulu/PrettierStudio",
  "version": "2.0.5",
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./dist/extension.js",
  "author": "루루 <alsrb4171@gmail.com>",
  "license": "MIT",
  "scripts": {
    "check-types": "tsc -p . --noEmit",
    "compile": "npm run check-types && node esbuild.mjs",
    "test": "npm run compile && tsc -p . --outDir .test-dist && node --test test/*.test.cjs",
    "build": "npm run check-types && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "prettier-studio.openSettings",
        "title": "Prettier Studio Open Setting"
      }
    ]
  },
  "devDependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "@types/node": "^26.0.0",
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  }
}
